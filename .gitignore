# Schema SQL and Flyway migrations are versioned with application code.
# Keep database dumps and backups in these ignored directories.
dumps/
backups/
*.dump
*.backup

# Environment files are local only, including example and sample files.
.env
.env.*
*.env
*.env.*
.envrc

# Local configuration and secret directories.
.secrets/
secrets/
credentials/
application-local.yml
application-local.yaml
application-local.properties

# Private keys and credential stores.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519

# Cloud service credentials. Arbitrarily named secret JSON belongs in secrets/.
service-account*.json
service_account*.json
*-service-account*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
application_default_credentials.json
credentials.json

# macOS metadata.
.DS_Store

# Local agent caches.
.serena/
