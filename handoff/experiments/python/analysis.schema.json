{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentStatus",
    "sections",
    "summary",
    "mindmap"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "contentStatus": {
      "type": "string",
      "enum": [
        "ANALYZABLE",
        "NOT_ANALYZABLE"
      ]
    },
    "sections": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 0,
          "items": {
            "type": "string"
          }
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sectionKey",
              "title",
              "startSegmentId",
              "endSegmentId",
              "sourceSegmentIds",
              "summary",
              "subtopics",
              "keywords",
              "detail"
            ],
            "properties": {
              "sectionKey": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "startSegmentId": {
                "type": "string"
              },
              "endSegmentId": {
                "type": "string"
              },
              "sourceSegmentIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "summary": {
                "type": "string"
              },
              "subtopics": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "keywords": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              },
              "detail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "takeaway",
                  "explanation",
                  "applicationTips",
                  "recommendedTools",
                  "usageKeywords",
                  "examples"
                ],
                "properties": {
                  "takeaway": {
                    "type": "string"
                  },
                  "explanation": {
                    "type": "string"
                  },
                  "applicationTips": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "title",
                        "text",
                        "origin",
                        "sourceSegmentIds"
                      ],
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "origin": {
                          "type": "string",
                          "enum": [
                            "SOURCE",
                            "AI_SUGGESTION"
                          ]
                        },
                        "sourceSegmentIds": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "recommendedTools": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "reason",
                        "origin",
                        "sourceSegmentIds"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "reason": {
                          "type": "string"
                        },
                        "origin": {
                          "type": "string",
                          "enum": [
                            "SOURCE",
                            "AI_SUGGESTION"
                          ]
                        },
                        "sourceSegmentIds": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "usageKeywords": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string"
                    }
                  },
                  "examples": {
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "text",
                        "origin",
                        "sourceSegmentIds"
                      ],
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "origin": {
                          "type": "string",
                          "enum": [
                            "SOURCE",
                            "AI_SUGGESTION"
                          ]
                        },
                        "sourceSegmentIds": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oneLine",
        "keyPoints",
        "practicalPoints",
        "mentionedTools",
        "keywords",
        "highlightSectionKeys"
      ],
      "properties": {
        "oneLine": {
          "type": "string"
        },
        "keyPoints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string"
          }
        },
        "practicalPoints": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "origin",
              "sourceSegmentIds"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "origin": {
                "type": "string",
                "enum": [
                  "SOURCE",
                  "AI_SUGGESTION"
                ]
              },
              "sourceSegmentIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "mentionedTools": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "sourceSegmentIds"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sourceSegmentIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "keywords": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "highlightSectionKeys": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mindmap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootTitle",
        "sectionKeys"
      ],
      "properties": {
        "rootTitle": {
          "type": "string"
        },
        "sectionKeys": {
          "type": "array",
          "maxItems": 15,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
