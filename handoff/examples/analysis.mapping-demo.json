    "captions": {
      "videoId": "fixture0001",
      "language": "ko",
      "segments": [
        {
          "segmentId": "s000001",
          "startMs": 0,
          "endMs": 5000,
          "text": "컨테이너는 애플리케이션과 필요한 실행 환경을 함께 담습니다."
        },
        {
          "segmentId": "s000002",
          "startMs": 5000,
          "endMs": 10000,
          "text": "컨테이너는 호스트 운영체제의 커널을 공유합니다."
        },
        {
          "segmentId": "s000003",
          "startMs": 10000,
          "endMs": 15000,
          "text": "가상 머신은 게스트 운영체제를 포함합니다."
        },
        {
          "segmentId": "s000004",
          "startMs": 15000,
          "endMs": 20000,
          "text": "이미지는 컨테이너를 실행하는 데 사용하는 읽기 전용 템플릿입니다."
        },
        {
          "segmentId": "s000005",
          "startMs": 20000,
          "endMs": 25000,
          "text": "같은 이미지로 여러 컨테이너를 실행할 수 있습니다."
        },
        {
          "segmentId": "s000006",
          "startMs": 25000,
          "endMs": 30000,
          "text": "실행 중인 컨테이너를 바꿔도 원래 이미지는 바뀌지 않습니다."
        },
        {
          "segmentId": "s000007",
          "startMs": 30000,
          "endMs": 35000,
          "text": "운영에서는 이미지 버전을 고정하면 같은 환경을 재현하기 쉽습니다."
        },
        {
          "segmentId": "s000008",
          "startMs": 35000,
          "endMs": 40000,
          "text": "이번 팀 실험에서 반복 작업은 40분에서 10분으로 줄었습니다."
        },
        {
          "segmentId": "s000009",
          "startMs": 40000,
          "endMs": 45000,
          "text": "이 수치는 한 팀의 내부 측정이고 모든 환경에 적용되는 값은 아닙니다."
        },
        {
          "segmentId": "s000010",
          "startMs": 45000,
          "endMs": 50000,
          "text": "배포 전 테스트를 실행해 동작을 확인합니다."
        },
        {
          "segmentId": "s000011",
          "startMs": 50000,
          "endMs": 55000,
          "text": "실패한 작업의 이유를 기록하고 성공한 단계는 보존합니다."
        },
        {
          "segmentId": "s000012",
          "startMs": 55000,
          "endMs": 60000,
          "text": "비밀키는 이미지에 넣지 않고 실행 환경에서 주입합니다."
        }
      ]
    },
    "durationMs": 60000,
